{
  "name": "@opbot/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Static web app to play One Piece TCG against the opbot bot, on the upstream tcg-engines board UI. The engine and the bot run in a Web Worker.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "bun test ./test",
    "typecheck": "bun scripts/typecheck.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@floating-ui/dom": "1.7.6",
    "@mantine/core": "9.0.0",
    "@mantine/hooks": "9.0.0",
    "@opbot/core": "workspace:*",
    "@radix-ui/react-popover": "1.1.15",
    "@tabler/icons-react": "3.44.0",
    "@tcg/op-engine": "link:../../vendor/tcg-engines/submodules/one-piece/packages/engine",
    "@tcg/protocol": "link:../../vendor/tcg-engines/submodules/agnostic-simulator/packages/protocol",
    "@tcg/simulator-contract": "link:../../vendor/tcg-engines/submodules/agnostic-simulator/packages/simulator-contract",
    "@tcg/simulator-runtime": "link:../../vendor/tcg-engines/submodules/agnostic-simulator/packages/simulator-runtime",
    "@tcg/simulator-ui": "link:../../vendor/tcg-engines/submodules/agnostic-simulator/packages/simulator-ui",
    "canvas-confetti": "1.9.4",
    "motion": "12.40.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.14",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "24.12.4",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
