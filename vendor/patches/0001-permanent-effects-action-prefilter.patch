 const activeEvaluations = new WeakMap<MatchState, Set<string>>();
 
+// opbot patch 0001: static per-card index of permanent-effect action kinds.
+// Every permanent-effect scan below only acts on sources whose printed
+// permanent effects contain a given action, so checking this first skips the
+// expensive in-play / negation / condition evaluation for all other cards.
+// Card definitions are immutable, so the index never needs invalidation.
+const permanentActionKindsByCardId = new Map<string, ReadonlySet<string>>();
+
+function cardHasPermanentAction(cardId: string, actionKinds: readonly string[]): boolean {
+  let kinds = permanentActionKindsByCardId.get(cardId);
+  if (!kinds) {
+    const collected = new Set<string>();
+    for (const effect of getCard(cardId).effects?.permanentEffects ?? []) {
+      for (const action of effect.actions) collected.add(action.action);
+    }
+    kinds = collected;
+    permanentActionKindsByCardId.set(cardId, kinds);
+  }
+  for (const kind of actionKinds) {
+    if (kinds.has(kind)) return true;
+  }
+  return false;
+}
+
+const DYNAMIC_MODIFIER_ACTION = {
+  power: "modifyPower",
+  cost: "modifyCost",
+  counter: "modifyCounter",
+} as const;
